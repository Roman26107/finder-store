# Local demo only. Generate a unique DJANGO_SECRET_KEY before deployment.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=FINDER <no-reply@example.com>
DATABASE_ENGINE=sqlite
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHANNEL_USERNAME=
# Optional integration. Configure a separate, random secret in both repositories.
AURENE_API_KEYS_JSON=
AURENE_API_REQUIRE_HTTPS=false