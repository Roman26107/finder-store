DOMAIN=shop.example.com
WWW_DOMAIN=www.shop.example.com
LETSENCRYPT_EMAIL=admin@example.com
NGINX_HTTPS=false
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-unique-random-secret-before-deployment
DJANGO_ALLOWED_HOSTS=shop.example.com,www.shop.example.com,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://shop.example.com,https://www.shop.example.com
DJANGO_TRUST_X_FORWARDED_PROTO=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0
DATABASE_ENGINE=postgresql
POSTGRES_DB=finder
POSTGRES_USER=finder
POSTGRES_PASSWORD=replace-with-a-unique-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=FINDER <no-reply@example.com>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
AURENE_API_KEYS_JSON=
AURENE_API_REQUIRE_HTTPS=true
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHANNEL_USERNAME=