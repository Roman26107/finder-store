# Sourced by Bash. Keep the real file outside the repository, mode 0600.
PROJECT_DIR=/opt/finder
COMPOSE_FILE=/opt/finder/docker-compose.yml
POSTGRES_SERVICE=db
RESTIC_REPOSITORY=s3:https://s3.example.com/BUCKET-NAME/finder
AWS_ACCESS_KEY_ID=CHANGE-ME-ACCESS-KEY
AWS_SECRET_ACCESS_KEY=CHANGE-ME-SECRET-KEY
AWS_DEFAULT_REGION=ru-1
RESTIC_S3_BUCKET_LOOKUP=path
RESTIC_PASSWORD_FILE=/etc/finder/restic-password
RESTIC_CACHE_DIR=/var/cache/finder-restic
BACKUP_STATE_DIR=/opt/finder/backups/restic
BACKUP_STAGING_DIR=/opt/finder/backups/restic/staging
BACKUP_LOCK_FILE=/run/lock/finder-backup.lock
FULL_BACKUP_TAG=finder-full
DATABASE_BACKUP_TAG=finder-db
FULL_BACKUP_KEEP_WITHIN=3d
DATABASE_BACKUP_KEEP_WITHIN=48h
BACKUP_LOCK_WAIT_SECONDS=7200
BACKUP_VERIFY_READ_DATA_SUBSET=5%
BACKUP_NOTIFY_SUCCESS=true
DATABASE_BACKUP_NOTIFY_SUCCESS=false
MAINTENANCE_NOTIFY_SUCCESS=false
BACKUP_TELEGRAM_BOT_TOKEN=
BACKUP_TELEGRAM_CHAT_ID=