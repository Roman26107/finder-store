[Unit]
Description=Test restoring FINDER PostgreSQL backup
Documentation=file://@PROJECT_DIR@/deploy/backup/README.md
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=FINDER_BACKUP_ENV=/etc/finder/backup.env
ExecStart=/usr/bin/bash /usr/local/lib/finder-backup/verify.sh --restore-test
TimeoutStartSec=infinity
UMask=0077
Nice=15
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target